# Local CMDBuild 4.2 compatibility harness only. Do not use for delivery.
COMPOSE_PROJECT_NAME=cmdbuild42

# The published CMDBuild port. PostgreSQL remains private to the Compose network.
CMDBUILD42_HOST_PORT=8094

# Download the vendor cmdbuild-4.2.0.war into artifacts/ and set its SHA-256.
# scripts/download-cmdbuild42-war.sh prints the value after validating the archive.
CMDBUILD42_WAR_SHA256=

# Clean demo database created by the vendor cmdbuild.sh dbconfig command.
CMDBUILD42_DB_NAME=cmdbuild42
CMDBUILD42_DB_USER=cmdbuild42
CMDBUILD42_DB_PASSWORD=change-local-cmdbuild42-password
CMDBUILD42_DB_SUPERUSER=postgres
CMDBUILD42_DB_SUPERUSER_PASSWORD=change-local-postgres-password
