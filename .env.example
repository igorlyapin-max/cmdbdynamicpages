# Copy this file to .env on the deployment host and replace placeholders.
# Do not commit real .env files.

CMDBDYNAMIC_IMAGE=registry.example.local/gkm/cmdbdynamicpages:v0.1.0-static-baseline

NODE_ENV=production
PROXY_HOST=0.0.0.0
PROXY_PORT=8093
CMDBUILD_ORIGIN=http://cmdbuild.example.local:8090

CMDBDYNAMIC_REDIS_URL=redis://redis.example.local:6379/0
CMDBDYNAMIC_REDIS_PASSWORD_FILE=/run/secrets/cmdbdynamicpages_redis_password
CMDBDYNAMIC_REDIS_PASSWORD_FILE_HOST=./secrets/cmdbdynamicpages_redis_password
CMDBDYNAMIC_REDIS_REQUIRED=true
CMDBDYNAMIC_HEALTH_REDIS_REQUIRED=true

CMDBDYNAMICPAGES_CSRF_SECRET=replace-me
CMDP_PROXY_ALLOWLIST_STRICT=true

CMDP_D2_RENDER_ENABLED=true
CMDP_D2_BINARY=/usr/local/bin/d2
CMDP_D2_TIMEOUT_MS=3000
CMDP_D2_MAX_INPUT_BYTES=2097152
CMDP_D2_MAX_OUTPUT_BYTES=10485760
CMDP_D2_MAX_DIAGRAMS=8
CMDP_D2_CONCURRENCY=2
CMDP_D2_LAYOUT=dagre
CMDP_D2_LAYOUT_ALLOWLIST=dagre,elk
CMDP_D2_IMPORT_BINARY=/usr/local/bin/cmdp-d2-import
CMDP_D2_IMPORT_TIMEOUT_MS=5000
CMDP_D2_IMPORT_MAX_INPUT_BYTES=1048576
CMDP_D2_IMPORT_MAX_OUTPUT_BYTES=4194304
CMDP_D2_IMPORT_MAX_ELEMENTS=5000
CMDP_D2_IMPORT_PROPOSAL_TTL_MS=1800000
CMDP_D2_IMPORT_ASSISTANT_MAX_SPEC_BYTES=262144
CMDP_TEMPLATE_REQUEST_MAX_BYTES=5767168

CMDBDYNAMIC_EXECUTION_THROTTLE_ENABLED=true
CMDBDYNAMIC_EXECUTION_THROTTLE_MAX_PER_SCOPE=2
CMDBDYNAMIC_EXECUTION_THROTTLE_MAX_GLOBAL=20
CMDBDYNAMIC_EXECUTION_THROTTLE_RETRY_AFTER_SEC=5

CMDP_LOG_LEVEL=info
CMDP_LOG_FORMAT=json
CMDP_LOG_TARGET=stdout
CMDP_EXTERNAL_LOG_SINK=
CMDP_DIAGNOSTIC_MODE=off
CMDP_LOG_REDACT_HEADERS=cookie,authorization,cmdbuild-authorization,x-csrf-token,x-cmdbdynamicpages-csrf,set-cookie
CMDP_LOG_REDACT_QUERY=password,passwd,pwd,token,secret,authorization,auth,csrf,x-cmdbdynamicpages-csrf

# Optional Designer-only LiteLLM assistant. Runtime rendering does not call LLM.
# CMDP_ASSISTANT_ENABLED is deprecated/no-op; use Designer RuntimeConfigJson assistant.llm.enabled.
CMDP_ASSISTANT_ENABLED=false
LITELLM_BASE_URL=http://litellm.example.local:4000/v1
CMDP_LITELLM_ALLOWED_BASE_URLS=http://litellm.example.local:4000/v1
LITELLM_MODEL=corp-openai-gpt-4.1-mini
LITELLM_API_KEY_FILE=/run/secrets/cmdbdynamicpages_litellm_api_key
LITELLM_API_KEY_FILE_HOST=./secrets/cmdbdynamicpages_litellm_api_key

# Optional syslog sink. Leave CMDP_LOG_TARGET=stdout unless the contour has a syslog/collector route.
CMDP_SYSLOG_HOST=syslog.example.local
CMDP_SYSLOG_PORT=514
CMDP_SYSLOG_PROTOCOL=udp
CMDP_SYSLOG_FACILITY=local0

CMDBUILD_REQUEST_TIMEOUT_MS=10000
CMDBDYNAMIC_HEALTH_TIMEOUT_MS=2000
CMDBDYNAMIC_REDIS_KEY_PREFIX=cmdp
CMDBDYNAMIC_REDIS_TIMEOUT_MS=500
